# Copy to .env via scripts/gen_env.sh (fills the passwords). Never commit .env.
POSTGRES_USER=signals
POSTGRES_PASSWORD=__PG__
POSTGRES_DB=signals
REDIS_PASSWORD=__REDIS__

DATABASE_URL=postgresql://signals:__PG__@db:5432/signals
REDIS_URL=redis://:__REDIS__@redis:6379/0

BINANCE_FAPI_URL=https://fapi.binance.com
BINANCE_WS_URL=wss://fstream.binance.com

COINGECKO_BASE_URL=https://api.coingecko.com/api/v3
COINGECKO_API_KEY=
# Optional fixed USDT->INR rate, used only if the CoinGecko rate lookup fails
USDT_INR_FALLBACK=

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

SYMBOLS=BTCUSDT,ETHUSDT,BNBUSDT,XRPUSDT,SOLUSDT,TRXUSDT,DOGEUSDT,LINKUSDT
BACKFILL_YEARS=2
UNIVERSE_SIZE=8
TIMEFRAMES=15m,1h,4h
SIM_MAX_LEVERAGE=3
TZ=UTC
