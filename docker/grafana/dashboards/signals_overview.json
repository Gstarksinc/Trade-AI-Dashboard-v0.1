  "panels": [
    {
      "collapsed": false,
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 0 },
      "id": 1,
      "title": "Ingestion Lag & Last Candle Age",
      "type": "timeseries",
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "Prometheus" },
          "expr": "signals_ingestion_lag_seconds",
          "legendFormat": "Lag {{symbol}} ({{timeframe}})"
        },
        {
          "datasource": { "type": "prometheus", "uid": "Prometheus" },
          "expr": "signals_last_candle_age_seconds",
          "legendFormat": "Age {{symbol}} ({{timeframe}})"
        }
      ]
    },
    {
      "collapsed": false,
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 0 },
      "id": 2,
      "title": "Stream Consumer Lag & DLQ Size",
      "type": "timeseries",
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "Prometheus" },
          "expr": "signals_stream_consumer_lag",
          "legendFormat": "Lag {{stream}}:{{group}}"
        },
        {
          "datasource": { "type": "prometheus", "uid": "Prometheus" },
          "expr": "signals_redis_dlq_size",
          "legendFormat": "DLQ {{stream}}"
        }
      ]
    },
    {
      "collapsed": false,
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 0 },
      "id": 3,
      "title": "Signals Generated Today & State Transitions",
      "type": "timeseries",
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "Prometheus" },
          "expr": "sum by (symbol) (signals_generated_today)",
          "legendFormat": "Signals {{symbol}}"
        },
        {
          "datasource": { "type": "prometheus", "uid": "Prometheus" },
          "expr": "sum by (state) (rate(signals_lifecycle_total[5m]))",
          "legendFormat": "Rate: {{state}}"
        }
      ]
    },
    {
      "collapsed": false,
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 8 },
      "id": 4,
      "title": "Model Prediction Confidence & Predictions Rate",
      "type": "timeseries",
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "Prometheus" },
          "expr": "histogram_quantile(0.90, sum(rate(signals_model_confidence_bucket[5m])) by (le, symbol))",
          "legendFormat": "P90 Conf {{symbol}}"
        },
        {
          "datasource": { "type": "prometheus", "uid": "Prometheus" },
          "expr": "sum by (direction) (rate(signals_predictions_total[5m]))",
          "legendFormat": "Preds/sec ({{direction}})"
        }
      ]
    },
    {
      "collapsed": false,
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 8 },
      "id": 5,
      "title": "API Gateway Request Latency (P50, P95)",
      "type": "timeseries",
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "Prometheus" },
          "expr": "histogram_quantile(0.50, sum(rate(signals_api_latency_seconds_bucket[5m])) by (le))",
          "legendFormat": "P50 Latency"
        },
        {
          "datasource": { "type": "prometheus", "uid": "Prometheus" },
          "expr": "histogram_quantile(0.95, sum(rate(signals_api_latency_seconds_bucket[5m])) by (le))",
          "legendFormat": "P95 Latency"
        }
      ]
    },
    {
      "collapsed": false,
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 8 },
      "id": 6,
      "title": "Infrastructure: Redis Memory & DB Size",
      "type": "timeseries",
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "Prometheus" },
          "expr": "signals_redis_memory_used_bytes",
          "legendFormat": "Redis Memory"
        },
        {
          "datasource": { "type": "prometheus", "uid": "Prometheus" },
          "expr": "signals_db_size_bytes",
          "legendFormat": "PostgreSQL DB Size"
        }
      ]
    }
